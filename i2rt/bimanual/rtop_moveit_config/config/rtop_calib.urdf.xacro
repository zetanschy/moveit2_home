<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rtop">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import rtop urdf file -->
    <xacro:include filename="$(find rtop_description)/urdf/rtop_design.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="rtop_calib.ros2_control.xacro" />


    <xacro:rtop_calib_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
