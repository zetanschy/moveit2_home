<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="yam">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import yam urdf file -->
    <xacro:include filename="$(find yam_arm_description)/urdf/yam_cam.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="yam.ros2_control.xacro" />


    <xacro:yam_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
